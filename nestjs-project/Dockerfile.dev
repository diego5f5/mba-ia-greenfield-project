FROM node:25.6.0-slim

# ffmpeg provides ffprobe/ffmpeg for the video worker (phase-03-videos/TD-08);
# the same image serves nestjs-api, where the test suite runs.
RUN apt update && apt install -y procps curl ffmpeg

WORKDIR /home/node/app

# node_modules is a named volume (compose.yaml). Creating the directory here as
# `node` makes Docker initialize a new volume owned by `node`; otherwise it is
# owned by root and `npm install` fails with EACCES.
RUN mkdir -p /home/node/app/node_modules && chown -R node:node /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ]
